# Runtime / cache
history.jsonl
cache/
image-cache/
paste-cache/
mcp-needs-auth-cache.json
stats-cache.json
session-env/
shell-snapshots/
sessions/
debug/
file-history/
telemetry/

# Project-specific state
projects/
tasks/
teams/
todos/
scheduled-tasks/

# Security warning state files
security_warnings_state_*.json

# Runtime state, logs and secrets — never portable config
security/
# daemon/ holds control.key
daemon/
jobs/
chrome/
daemon.log
recall-debug.log
gh-pr-status-cache.json
.last-update-result.json

# Backups (auto-generated)
*.bak
*.bak.*

# Auto-managed by Claude Code
plugins/
ide/
package.json

# Transient plan files
plans/

# Skills: symlinks to local skill repos aren't portable config; own skills are.
# Trailing-slash ignore blocks re-inclusion, so exclude contents and negate.
skills/*
# Kept after uninstalling the caveman plugin — now our own copy, not vendored.
!skills/caveman-compress/
!skills/fleet/
# Vendored skills stay ignored whether installed as symlink or copy — list them:
#   jq -r '.skills|to_entries[]|"\(.key)\t\(.value.source)"' ~/.agents/.skill-lock.json

# Python bytecode (skills/*/scripts run as modules)
__pycache__/
*.pyc

# Local state flags
.last-cleanup

# Fleet runtime state — the ledger, the cockpit board, the instrument pin; never committed
.fleet/
# Fleet worktrees claim-ticket.sh creates inside the checkout
.worktrees/

# Auto-generated backups
backups/
*.original.md

# caveman-compress runtime marker — writer unidentified, but it reappears
.caveman-active
# ponytail runtime marker — same kind of transient *-active flag
.ponytail-active

# agent-brain — installer output, not our config. Reinstalled on every update.
.agent-brain/
hooks/memory-*.sh
hooks/lib/
agents/memory-*.agent.md
