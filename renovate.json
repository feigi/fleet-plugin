{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["nvm", "github-actions", "custom.regex"],
  "dependencyDashboard": false,
  "timezone": "UTC",
  "schedule": ["* * 1-3 * *"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "automerge": true,
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "github-actions": { "pinDigests": true },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?[ \\t]*\\n[^\\n]*?[@:][ \\t]*\"?(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ]
    }
  ],
  "packageRules": [
    { "matchUpdateTypes": ["major"], "automerge": false, "labels": ["major"] },
    { "matchUpdateTypes": ["minor"], "labels": ["minor"] },
    { "matchUpdateTypes": ["patch", "digest", "pinDigest"], "labels": ["patch"] }
  ]
}
