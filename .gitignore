# The runner the pre-ADR-0015 `./agent-test` bootstrap materialized from
# claim-ticket.sh on each run. Nothing writes it any more — `agent-test` is the
# runner itself now — but checkouts and worktrees made before that still hold
# one. IGNORED rather than left untracked — `git worktree remove` refuses on an
# untracked file and deletes an ignored one silently, so dropping this line
# would strand every release reap.sh attempts on such a worktree.
.agent-test.sh

# Fleet runtime state — the ledger, the cockpit board, the instrument pin; never committed
.fleet/
# Fleet worktrees claim-ticket.sh creates inside the checkout
.worktrees/

# agent-brain writes a memory cache into whatever repo it is invoked from
.agent-brain/

# Backups (auto-generated)
*.bak
*.bak.*
