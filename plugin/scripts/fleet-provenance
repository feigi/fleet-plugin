#!/usr/bin/env node
// The Provenance check (#1335, ADR 0003 point 4, ADR 0021, CONTEXT.md § Install
// "Provenance check"). Names the live Install root — the realpath of omp's
// `node_modules/@feigi/fleet-ctl` package entry, the one path every install kind
// places (ADR 0021) — its kind and recorded version, and hashes the placed
// Resolver (`~/.fleet/bin/fleet-run`) against each install's own copy and
// refuses on drift. Writes nothing, mutates no config — every path below is
// read-only.
//
// The `enabledProviders: ["claude-plugins"]` assertion retired here (ADR
// 0021): omp's #11362 fix (shipped 18.2.1) exempts omp-origin installs from
// that provider gate, and the native package route never depended on it.
// Asserting it refused correct setups.
//
// SEPARATE FILE, not `fleet-run --check`. `fleet-run` is deliberately a
// single self-contained file because it alone gets copied to
// `~/.fleet/bin/fleet-run` (see that file's own header) — folding a second,
// unrelated responsibility into it would grow the one artefact outside the
// plugin for a feature that never needs to travel there. This script stays
// inside the install and is reached like every other one, through the
// Resolver: `fleet-run fleet-provenance`.
"use strict";

const fs = require("node:fs");
const path = require("node:path");
const os = require("node:os");
const crypto = require("node:crypto");

const NAME = "fleet-provenance";
const PLUGIN_KEY = "@feigi/fleet-ctl"; // ADR 0006 name; ADR 0021 — the node_modules package dir.

// Same resolution point as scripts/fleet-run (its header names the shape of
// each install kind). Duplicated rather than shared because a module the
// Resolver requires would have to travel with its placed copy — see
// fleet-run's own header.
function resolveInstall(home) {
  const packagePath = path.join(home, ".omp", "plugins", "node_modules", PLUGIN_KEY);
  let stat;
  try {
    stat = fs.lstatSync(packagePath);
  } catch (e) {
    return { present: false, packagePath, reason: `no omp plugin "${PLUGIN_KEY}" at ${packagePath} (${e.code || e.message})` };
  }
  try {
    return { present: true, packagePath, isLink: stat.isSymbolicLink(), installPath: fs.realpathSync(packagePath) };
  } catch (e) {
    return { present: false, packagePath, reason: `omp plugin "${PLUGIN_KEY}" at ${packagePath} does not resolve (${e.code || e.message})` };
  }
}

// Version lives in omp's runtime plugin lock, which every install kind writes
// (ADR 0021 point 4) — a link records the manifest's own `package.json`
// version (measured on 18.4.8: `0.0.0`, the placeholder), so the number never
// identifies a link; `kind:` does. Read tolerantly: any shape problem degrades
// to null, it never fails the check, because the version is informational.
function readLockVersion(home) {
  const lockPath = path.join(home, ".omp", "plugins", "omp-plugins.lock.json");
  let json;
  try {
    json = JSON.parse(fs.readFileSync(lockPath, "utf8"));
  } catch {
    return null;
  }
  const entry = json && json.plugins && json.plugins[PLUGIN_KEY];
  return entry && typeof entry.version === "string" ? entry.version : null;
}

// Every regular file under `<root>/scripts`, repo-relative, sorted — a
// filesystem walk rather than `git ls-files`: an installed copy need not
// carry a .git at all (a directory-source install can exclude it, ADR 0003),
// so git is not an instrument this check can rely on being present.
function walkFiles(dir, base = dir, out = []) {
  let entries;
  try {
    entries = fs.readdirSync(dir, { withFileTypes: true });
  } catch (e) {
    return { error: `cannot list ${dir} (${e.code || e.message})` };
  }
  for (const entry of entries.sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0))) {
    const full = path.join(dir, entry.name);
    if (entry.isDirectory()) {
      // A subtree that cannot be listed must fail the digest, never shrink it:
      // a partial file set would certify as complete.
      const sub = walkFiles(full, base, out);
      if (sub.error) return sub;
    } else if (entry.isFile()) out.push({ rel: path.relative(base, full), full });
  }
  return { files: out };
}

function sha256(buf) {
  return crypto.createHash("sha256").update(buf).digest("hex");
}

// One digest over every file's content under `<root>/scripts`, keyed by
// relative path so a rename changes it and a mtime-only touch does not.
function digestScriptsDir(root) {
  const scriptsDir = path.join(root, "scripts");
  const listed = walkFiles(scriptsDir);
  if (listed.error) return { error: listed.error };
  if (listed.files.length === 0) return { error: `no files under ${scriptsDir} — refusing to certify an empty set` };
  const lines = listed.files.map((f) => `${sha256(fs.readFileSync(f.full))}  ${f.rel}`);
  return { digest: sha256(Buffer.from(lines.join("\n") + "\n", "utf8")), fileCount: listed.files.length };
}

// Which install kind produced this root, from where the package entry points:
// a symlink resolving inside omp's plugin cache → a marketplace install; the
// entry itself a real directory under node_modules (not a symlink) → an npm
// install; a symlink pointing anywhere else → a linked checkout. Compare
// canonicalized paths — macOS resolves /tmp through /private/tmp (measured;
// the same reason fleet-bootstrap's canonical() exists), so a raw string
// prefix misreports an npm install as an unknown shape on those boxes.
function kindOf(res) {
  const { packagePath, installPath, isLink } = res;
  let nodeModules;
  try {
    nodeModules = fs.realpathSync(path.dirname(packagePath));
  } catch {
    nodeModules = path.dirname(packagePath);
  }
  if (isLink) {
    if (installPath.includes(`${path.sep}.omp${path.sep}plugins${path.sep}cache${path.sep}`)) return "marketplace-install";
    return "linked-checkout";
  }
  if (installPath.startsWith(nodeModules + path.sep)) return "npm-install";
  return "unrecognized-install-shape";
}

function main() {
  const argv = process.argv.slice(2);
  for (let i = 0; i < argv.length; i++) {
    process.stderr.write(`${NAME}: unrecognized argument ${argv[i]}\n`);
    process.exit(2);
  }

  const home = os.homedir();
  const reg = resolveInstall(home);

  if (!reg.present) {
    process.stderr.write(`${NAME}: ${reg.reason}\n`);
    process.exit(2);
  }

  const placedPath = path.join(home, ".fleet", "bin", "fleet-run");
  let placedBuf = null;
  let placedError = null;
  try {
    placedBuf = fs.readFileSync(placedPath);
  } catch (e) {
    placedError = `${e.code || e.message}`;
  }

  let failed = false;

  const kind = kindOf(reg);
  const version = readLockVersion(home);
  process.stdout.write(`${NAME}: Install root: ${reg.installPath}\n`);
  process.stdout.write(`${NAME}: kind: ${kind}\n`);
  process.stdout.write(`${NAME}: version: ${version ?? "(none recorded)"}\n`);

  const digest = digestScriptsDir(reg.installPath);
  if (digest.error) {
    process.stdout.write(`${NAME}: scripts/ digest: UNAVAILABLE — ${digest.error}\n`);
  } else {
    process.stdout.write(`${NAME}: scripts/ digest: sha256 ${digest.digest} (${digest.fileCount} files)\n`);
  }

  const installedRunPath = path.join(reg.installPath, "scripts", "fleet-run");
  let installedRunBuf = null;
  let installedRunError = null;
  try {
    installedRunBuf = fs.readFileSync(installedRunPath);
  } catch (e) {
    installedRunError = `${e.code || e.message}`;
  }

  if (placedError) {
    process.stdout.write(`${NAME}: Resolver drift: REFUSED — placed copy ${placedPath} unreadable (${placedError})\n`);
    failed = true;
  } else if (installedRunError) {
    process.stdout.write(`${NAME}: Resolver drift: REFUSED — installed copy ${installedRunPath} unreadable (${installedRunError})\n`);
    failed = true;
  } else if (!placedBuf.equals(installedRunBuf)) {
    process.stdout.write(
      `${NAME}: Resolver drift: REFUSED — ${placedPath} (sha256 ${sha256(placedBuf)}) `
      + `!= ${installedRunPath} (sha256 ${sha256(installedRunBuf)})\n`,
    );
    failed = true;
  } else {
    process.stdout.write(`${NAME}: Resolver drift: none — ${placedPath} matches ${installedRunPath}\n`);
  }

  if (kind === "linked-checkout") {
    // Not a failure: a link is the dev loop (ADR 0021). It is a NOTICE on
    // every other install's answer, because a linked root outranks an
    // installed copy of the same names in omp's own discovery — the check
    // above certified the LINK, not what a session without the link runs.
    process.stdout.write(
      `${NAME}: NOTICE: Install root is a linked checkout (${reg.installPath}) — this box develops the plugin; `
      + "every fleet-run answer above came from that checkout, not from an installed release.\n",
    );
  }

  process.exit(failed ? 1 : 0);
}

main();
